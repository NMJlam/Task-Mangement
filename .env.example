# Database — see docs/setup.md
# nodeDb() (pg): Docker Postgres for local dev, migrations, seeding, tests.
# httpDb() (@neondatabase/serverless): a Neon dev branch for request-path work.
#
# Local Docker default: postgresql://ctp:ctp@localhost:5432/ctp
# If you already run Postgres on 5432, set POSTGRES_PORT to a free port (e.g.
# 5433) AND change the port in the two URLs below to match.
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_URL_POOLED=

# Self-hosted Better Auth (runs inside the backend; see auth/auth.ts).
# BETTER_AUTH_URL    → public origin the browser uses (dev: http://localhost:5173)
# BETTER_AUTH_SECRET → cookie/token signing secret; generate with:
#                        node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# Your Google OAuth client (Google Cloud Console → Clients).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production bootstrap. FOUNDER_EMAIL is always required in production (the
# shared demo uses nathan.lam.rt@gmail.com). DEMO_DIRECTOR_EMAILS is a
# comma-separated list used only when SEED_DEMO=1.
SEED_DEMO=
FOUNDER_EMAIL=
DEMO_DIRECTOR_EMAILS=

# Cron endpoint bearer secret (protects /api/cron/*)
CRON_SECRET=

# IANA zone the club runs on. `daysUntil` on GET /api/events/:id/progress counts
# calendar days here, not in UTC — an evening event is off by one otherwise.
# Defaults to Australia/Melbourne when empty.
CLUB_TIMEZONE=Australia/Melbourne

# LOCAL ONLY — set to 1 to enable Better Auth email+password sign-in, so the API
# can be tested by hand without Google credentials (docs/setup.md). Leave empty
# everywhere else; never set it on Vercel.
DEV_PASSWORD_AUTH=

# AI assistant (R15) — Google AI Studio free tier. Setup: docs/setup.md.
# Opt-in per deployment: the assistant sends club data (event and task titles,
# member names, thread text) to Google, and AI Studio free-tier prompts may be
# retained and used to improve Google's products. Set AI_ENABLED=1 only where
# that has been agreed.
AI_ENABLED=
# aistudio.google.com → Get API key. Free tier, no card. Unrelated to the
# GOOGLE_CLIENT_* pair above, which is Better Auth sign-in.
GEMINI_API_KEY=
# Free-tier model id — check the current one in AI Studio; these names change,
# which is why this is a variable rather than a literal in code.
GEMINI_MODEL=gemini-2.5-flash
# Assistant runs per member per rolling 24h, counted off ai_run. The free tier
# has one shared quota; drop this to 10-15 before a demo.
AI_DAILY_RUN_CAP=50
