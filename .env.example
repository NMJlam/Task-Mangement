# Database — see docs/setup.md
# nodeDb() (pg): Docker Postgres for local dev, migrations, seeding, tests.
# httpDb() (@neondatabase/serverless): a Neon dev branch for request-path work.
#
# Local Docker default: postgresql://ctp:ctp@localhost:5432/ctp
# If you already run Postgres on 5432, set POSTGRES_PORT to a free port (e.g.
# 5433) AND change the port in the two URLs below to match.
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_URL_POOLED=

# Self-hosted Better Auth (runs inside the backend; see auth/auth.ts).
# BETTER_AUTH_URL    → public origin the browser uses (dev: http://localhost:5173)
# BETTER_AUTH_SECRET → cookie/token signing secret; generate with:
#                        node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# Your Google OAuth client (Google Cloud Console → Clients).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production bootstrap — db:seed creates one president invite for this address.
FOUNDER_EMAIL=

# App
APP_BASE_URL=

# Cron endpoint bearer secret (protects /api/cron/*)
CRON_SECRET=
