{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ctp/shared": ["../shared/src/index.ts"],
      "@ctp/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"]
}
